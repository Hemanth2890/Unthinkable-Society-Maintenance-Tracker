# Database
DATABASE_URL="postgresql://user:password@localhost:5432/society_tracker"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Resend (email notifications) - free tier: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Society Tracker <notices@yoursociety.app>"

# Cloudinary (photo uploads) - free tier: https://cloudinary.com
# Leave blank to use the local mock upload path during development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_URL=""

# Overdue detection
OVERDUE_THRESHOLD_DAYS=3
